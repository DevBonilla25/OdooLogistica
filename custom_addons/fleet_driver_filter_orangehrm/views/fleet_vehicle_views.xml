<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fleet_vehicle_view_form_inherit_orangehrm_driver_domain" model="ir.ui.view">
        <field name="name">fleet.vehicle.form.orangehrm.driver.domain</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='driver_id']" position="attributes">
                <attribute name="domain">[('id', 'in', allowed_driver_partner_ids)]</attribute>
            </xpath>
            <xpath expr="//field[@name='driver_id']" position="before">
                <field name="allowed_driver_partner_ids" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='driver_id']" position="after">
                <!-- Activar este check cambia el selector de solo choferes a todos los responsables internos. -->
                <field name="show_all_employee_driver_contacts"/>
            </xpath>
        </field>
    </record>
</odoo>
