<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fleet_vehicle_log_fuel.fleet_vehicle_log_fuel_action" model="ir.actions.act_window">
        <field name="name">Registros de combustible</field>
        <field name="view_mode">list,kanban,form,graph,pivot</field>
    </record>

    <record id="fleet_vehicle_log_fuel.fleet_vehicle_log_fuel_menu" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

    <record id="action_fleet_fuel_analysis" model="ir.actions.act_window">
        <field name="name">Analisis de combustible</field>
        <field name="res_model">fleet.vehicle.log.fuel</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="fleet_vehicle_log_fuel.fleet_vehicle_log_fuel_view_search"/>
        <field name="context">{'search_default_approved': 1}</field>
    </record>

    <record id="action_fleet_fuel_monthly" model="ir.actions.act_window">
        <field name="name">Reporte mensual</field>
        <field name="res_model">fleet.vehicle.log.fuel</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="fleet_vehicle_log_fuel.fleet_vehicle_log_fuel_view_search"/>
        <field name="context">{'search_default_fuel_date': 1, 'search_default_approved': 1, 'group_by': ['date:month']}</field>
    </record>

    <menuitem id="menu_fleet_fuel_control"
              name="Combustible"
              parent="fleet.menu_root"
              sequence="40"
              groups="fleet.fleet_group_user"/>

    <menuitem id="menu_fleet_fuel_logs"
              name="Registros de combustible"
              parent="menu_fleet_fuel_control"
              action="fleet_vehicle_log_fuel.fleet_vehicle_log_fuel_action"
              sequence="10"
              groups="fleet.fleet_group_user"/>

    <menuitem id="menu_fleet_fuel_analysis"
              name="Analisis de combustible"
              parent="menu_fleet_fuel_control"
              action="action_fleet_fuel_analysis"
              sequence="20"
              groups="fleet.fleet_group_manager"/>

    <menuitem id="menu_fleet_fuel_monthly"
              name="Reporte mensual"
              parent="menu_fleet_fuel_control"
              action="action_fleet_fuel_monthly"
              sequence="30"
              groups="fleet.fleet_group_manager"/>
</odoo>
